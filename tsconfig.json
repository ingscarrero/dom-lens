{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true
  },
  "include": [
    ".wxt/wxt.d.ts",
    "entrypoints/**/*",
    "lib/**/*",
    "*.ts",
    "*.tsx"
  ]
}
